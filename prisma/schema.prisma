generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CareerType {
  VENTURE_CAPITAL
  CYBERSECURITY
  PRODUCT_MANAGEMENT
  CORPORATE_LAW
  QUANT_TRADING
}

enum SimulationStatus {
  IN_PROGRESS
  COMPLETED
}

enum RequesterRole {
  COUNSELOR
  STUDENT
}

enum StudentTier {
  ENTERPRISE_STUDENT
  PUBLIC_DEMO
}

/** A partner school/institution whitelisted for full enterprise access - either by email domain
 *  (auto-granted on login, see lib/authStudent.ts) or by a shared cohort access key (self-service
 *  upgrade via app/api/auth/cohort-key/route.ts for students on personal email domains). */
model SchoolOrganization {
  id          String   @id @default(uuid())
  name        String
  domains     String[]
  accessKey   String?  @unique
  partnerRef  String   @default("mindler")
  maxStudents Int      @default(500)
  createdAt   DateTime @default(now()) @map("created_at")

  students Student[]

  @@map("school_organizations")
}

model Student {
  id              String      @id @default(uuid())
  supabaseAuthId  String      @unique @map("supabase_auth_id")
  email           String      @unique
  name            String
  // Set only for a real Username + Password account (see lib/authStudent.ts) - null for
  // anonymous/guest students, who are keyed purely by supabaseAuthId (`anon_<uuid>`).
  username        String?     @unique
  // Entitlement tier gating simulation access - see lib/auth/entitlements.ts. Defaults to the
  // capped public-demo tier; upgraded to ENTERPRISE_STUDENT by a matching email domain (on login)
  // or a validated cohort access key (self-service, see app/api/auth/cohort-key/route.ts).
  tier            StudentTier @default(PUBLIC_DEMO)
  schoolId        String?     @map("school_id")
  school          SchoolOrganization? @relation(fields: [schoolId], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")

  simulationSessions SimulationSession[]

  @@map("students")
}

model SimulationSession {
  id                String            @id @default(uuid())
  studentId         String            @map("student_id")
  student           Student           @relation(fields: [studentId], references: [id])
  careerType        CareerType        @map("career_type")
  status            SimulationStatus  @default(IN_PROGRESS)
  // "child" | "professional" - see types/simulation.ts SimulationMode. Plain String (not a
  // Postgres enum) because ageTier's values ("10-12th") aren't valid enum identifiers.
  mode              String            @default("professional")
  // "10-12th" | "college_pro" - see types/simulation.ts AgeTier.
  ageTier           String            @default("college_pro") @map("age_tier")
  overallScore      Int?              @map("overall_score")
  feedbackSummary   String?           @map("feedback_summary")
  competencies      Json?             @map("competencies")
  keyStrengths      String[]          @default([]) @map("key_strengths")
  growthAreas       String[]          @default([]) @map("growth_areas")
  careerFitSummary  String?           @map("career_fit_summary")
  // Unguessable public identifier for the B2B scorecard verification route
  // (app/verify/scorecard/[hash]) - set once the full evaluation completes. Null until then.
  verificationHash  String?           @unique @map("verification_hash")
  // Public Supabase Storage URL for the server-rendered PDF scorecard (see
  // app/api/simulations/export-pdf/route.ts and lib/storage/pdf.ts) - null until the PDF has been
  // rendered and uploaded at least once. Acts as the cache key so a repeat export request never
  // re-renders the PDF.
  pdfUrl            String?           @map("pdf_url")
  // Partner/institutional attribution captured from a `?ref=` query param by proxy.ts at the
  // time the session was started - null for organic traffic. See proxy.ts for capture logic.
  partnerRef        String?           @map("partner_ref")
  startedAt         DateTime          @default(now()) @map("started_at")
  completedAt       DateTime?         @map("completed_at")

  actionLogs ActionLog[]

  @@map("simulation_sessions")
}

model SimulationRequest {
  id                   String        @id @default(uuid())
  name                 String
  role                 RequesterRole
  organization         String?
  requestedCareerTitle String        @map("requested_career_title")
  industry             String
  keySkills            String        @map("key_skills")
  createdAt            DateTime      @default(now()) @map("created_at")

  @@map("simulation_requests")
}

/** Vote tally for a planned (not-yet-built) catalog entry, keyed by its CatalogEntry.id slug from
 *  lib/catalogData.ts. One row per entry, created on first vote. */
model CatalogVote {
  id         String   @id @default(uuid())
  catalogId  String   @unique @map("catalog_id")
  voteCount  Int      @default(0) @map("vote_count")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("catalog_votes")
}

model ContactLead {
  id           String   @id @default(uuid())
  name         String
  email        String
  organization String?
  message      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("contact_leads")
}

model ActionLog {
  id              String            @id @default(uuid())
  sessionId       String            @map("session_id")
  session         SimulationSession @relation(fields: [sessionId], references: [id])
  stepSequence    Int               @map("step_sequence")
  studentInput    String            @map("student_input")
  returnedState   Json              @map("returned_state")
  decisionTag     String?           @map("decision_tag")
  /** Seconds the student took to respond to this step (null for the initial SESSION_START turn
   *  and any turn predating this field). Surfaced in the HUD countdown and fed into evaluation. */
  decisionTimeSeconds Int?          @map("decision_time_seconds")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("action_logs")
}
