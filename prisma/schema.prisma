generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CareerType {
  VENTURE_CAPITAL
  CYBERSECURITY
  PRODUCT_MANAGEMENT
  CORPORATE_LAW
  QUANT_TRADING
}

enum SimulationStatus {
  IN_PROGRESS
  COMPLETED
}

enum RequesterRole {
  COUNSELOR
  STUDENT
}

model Student {
  id              String   @id @default(uuid())
  supabaseAuthId  String   @unique @map("supabase_auth_id")
  email           String   @unique
  name            String
  createdAt       DateTime @default(now()) @map("created_at")

  simulationSessions SimulationSession[]

  @@map("students")
}

model SimulationSession {
  id                String            @id @default(uuid())
  studentId         String            @map("student_id")
  student           Student           @relation(fields: [studentId], references: [id])
  careerType        CareerType        @map("career_type")
  status            SimulationStatus  @default(IN_PROGRESS)
  // "child" | "professional" - see types/simulation.ts SimulationMode. Plain String (not a
  // Postgres enum) because ageTier's values ("10-12th") aren't valid enum identifiers.
  mode              String            @default("professional")
  // "10-12th" | "college_pro" - see types/simulation.ts AgeTier.
  ageTier           String            @default("college_pro") @map("age_tier")
  overallScore      Int?              @map("overall_score")
  feedbackSummary   String?           @map("feedback_summary")
  competencies      Json?             @map("competencies")
  keyStrengths      String[]          @default([]) @map("key_strengths")
  growthAreas       String[]          @default([]) @map("growth_areas")
  careerFitSummary  String?           @map("career_fit_summary")
  startedAt         DateTime          @default(now()) @map("started_at")
  completedAt       DateTime?         @map("completed_at")

  actionLogs ActionLog[]

  @@map("simulation_sessions")
}

model SimulationRequest {
  id                   String        @id @default(uuid())
  name                 String
  role                 RequesterRole
  organization         String?
  requestedCareerTitle String        @map("requested_career_title")
  industry             String
  keySkills            String        @map("key_skills")
  createdAt            DateTime      @default(now()) @map("created_at")

  @@map("simulation_requests")
}

model ContactLead {
  id           String   @id @default(uuid())
  name         String
  email        String
  organization String?
  message      String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("contact_leads")
}

model ActionLog {
  id              String            @id @default(uuid())
  sessionId       String            @map("session_id")
  session         SimulationSession @relation(fields: [sessionId], references: [id])
  stepSequence    Int               @map("step_sequence")
  studentInput    String            @map("student_input")
  returnedState   Json              @map("returned_state")
  decisionTag     String?           @map("decision_tag")
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("action_logs")
}
